# Absolute path to your trained checkpoint (.pt file)
# Example from your notebook:
#   .../Journal_EXP_FINAL/tvsum_canonical/models/split4/tvsum_canonical_split4_best.pt
CHECKPOINT_PATH=./models/best.pt

# Frame sampling rate (same as training). 15 means every 15th frame is scored.
SAMPLE_RATE=15

# Target fraction of original video length for the summary (knapsack budget).
# Your notebook used 0.20 for TVSum in the final inference cell.
SUMMARY_PROPORTION=0.20

# Upload limit (MB). Increase if you want to accept long videos.
MAX_UPLOAD_MB=200

# Auto-delete jobs older than N seconds (keeps disk usage bounded on HF Spaces).
# Set to 0 to disable.
JOB_TTL_SECONDS=21600
